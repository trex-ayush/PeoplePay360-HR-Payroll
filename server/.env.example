# Required. MongoDB Atlas or a local mongod.
#   Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/peoplepay360
#   Local: mongodb://127.0.0.1:27017/peoplepay360
MONGODB_URI=

# Required. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Required to create the first admin via POST /api/auth/admin.
# Later admins can be created by an existing admin instead.
ADMIN_SECRET=

PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Optional. Without these the invite link is still created, just not emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PeoplePay360 <no-reply@peoplepay360.local>
INVITE_EXPIRES_IN_DAYS=7
